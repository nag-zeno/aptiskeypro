# ==============================================================================
# APTISKEY - CẤU HÌNH BIẾN MÔI TRƯỜNG PRODUCTION (GCP / CLOUD RUN / VM)
# ==============================================================================
# Lưu ý: Sao chép nội dung này hoặc truyền trực tiếp vào Cloud Run Variables / .env

# --- CẤU HÌNH CHUNG ---
APP_NAME=AptisPro
DEBUG=False

# URL của website sau khi deploy (Ví dụ: https://aptispro-xxxxx.a.run.app hoặc https://aptiskey.com)
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com

# --- CƠ SỞ DỮ LIỆU ---
# Dành cho Cloud Run: Sử dụng PostgreSQL từ Neon/Supabase (Miễn phí) hoặc Cloud SQL
# Ví dụ PostgreSQL: postgresql://username:password@ep-cool-db.us-east-1.aws.neon.tech/aptispro_db?sslmode=require
DATABASE_URL=sqlite:///./aptispro_dev.db

# --- BẢO MẬT & JWT AUTH ---
# Khóa bí mật dùng để mã hóa JWT Token (Tạo một chuỗi ngẫu nhiên dài ít nhất 32 ký tự)
SECRET_KEY=generate-a-strong-random-secret-key-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
RESET_TOKEN_EXPIRE_MINUTES=15

# --- TRÍ TUỆ NHÂN TẠO (AI GRADER) ---
# API Key của Google Gemini để chấm điểm tự động các phần thi Writing & Speaking
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- TÀI KHOẢN QUẢN TRỊ VIÊN (ADMIN SEED) ---
ADMIN_EMAIL=admin@aptiskey.com
ADMIN_PASSWORD=Admin@StrongPassword2026
ADMIN_NAME=Administrator

# --- CỔNG THANH TOÁN (PAYOS - NẾU DÙNG) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
VIP_DURATION_DAYS=365
VIP_PRICE_VND=199000

# --- DỊCH VỤ GỬI EMAIL (RESEND - NẾU DÙNG) ---
RESEND_API_KEY=
EMAIL_FROM=noreply@aptispro.com
EMAIL_FROM_NAME=AptisPro

# --- CORS (Cross-Origin Resource Sharing) ---
ALLOWED_ORIGINS=["https://your-domain.com", "https://your-service-url.a.run.app"]
