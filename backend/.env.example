# =============================================
# AptisPro Backend - Environment Configuration
# =============================================
# Copy file này sang .env và điền thông tin thực tế

# --- Database ---
DATABASE_URL=postgresql://user:password@host:5432/aptispro_db
# Ví dụ Supabase: postgresql://postgres.abcxyz:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- JWT Security ---
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- App ---
APP_NAME=AptisPro
FRONTEND_URL=https://aptispro.com
BACKEND_URL=https://api.aptispro.com
DEBUG=false

# --- AI (Google Gemini) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# --- Payment (PayOS - VietQR) ---
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
VIP_DURATION_DAYS=365
VIP_PRICE_VND=199000

# --- Email (Resend.com - Free 3000 emails/month) ---
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@aptispro.com
EMAIL_FROM_NAME=AptisPro

# --- CORS ---
ALLOWED_ORIGINS=["https://aptispro.com", "http://localhost:8000", "http://localhost:5173"]
